#!/usr/bin/env python3
"""Protect the canonical public remote and each outgoing committed tree."""
from pathlib import Path
import subprocess
import sys

allowed = {
    'https://github.com/FengLi-AI/JotBloom-Notch-Assistant.git',
    'https://github.com/FengLi-AI/JotBloom-Notch-Assistant',
    'git@github.com:FengLi-AI/JotBloom-Notch-Assistant.git',
}
if len(sys.argv) < 3 or sys.argv[2] not in allowed:
    sys.exit('Refusing to push this checkout to an unexpected repository URL.')
root = Path(subprocess.check_output(['git', 'rev-parse', '--show-toplevel'], text=True).strip())
checker = root / 'scripts/check-repository-boundary.py'
subprocess.run([sys.executable, str(checker)], cwd=root, check=True)
commits = set()
for line in sys.stdin:
    _, local_sha, _, remote_sha = line.split()
    if set(local_sha) == {'0'}:
        continue
    command = ['git', 'rev-list', local_sha]
    exists = subprocess.run(['git', 'cat-file', '-e', remote_sha + '^{commit}'],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    if set(remote_sha) != {'0'} and exists:
        command.append('^' + remote_sha)
    else:
        command.extend(['--not', '--remotes=origin'])
    commits.update(subprocess.check_output(command, text=True).splitlines())
for sha in sorted(commits):
    subprocess.run([sys.executable, str(checker), '--tree', sha], cwd=root, check=True)
